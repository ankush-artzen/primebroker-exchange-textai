DATABASE_URL=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# openai | anthropic — if unset, OpenAI is used when OPENAI_API_KEY is set
# AI_PROVIDER="openai"

# Sarvam speech-to-text. Mic audio is sent here; the key stays on the server.
# https://dashboard.sarvam.ai
SARVAM_API_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Twilio Verify OTP login — no purchased Twilio phone number needed
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Optional. Falls back to TWILIO_AUTH_TOKEN if unset.
# OTP_TOKEN_SECRET=

# Temporary local login without SMS. Ignored when NODE_ENV=production.
# SKIP_OTP=1

# Signs browser sessions. Falls back to OTP_TOKEN_SECRET, then TWILIO_AUTH_TOKEN.
# SESSION_SECRET=

# One admin account. Create or reset it with: npm run admin:create
ADMIN_USERNAME=
ADMIN_PASSWORD=
# ADMIN_NAME="Admin"

# Superadmin sees every user and can allow admins to add brokers.
# Create or reset it with: npm run superadmin:create
SUPERADMIN_USERNAME=
SUPERADMIN_PASSWORD=
# SUPERADMIN_NAME="Super Admin"
